  "components": {
    "schemas": {
      "AssetType": {
        "type": "string",
        "enum": [
          "voice",
          "video",
          "image"
        ],
        "title": "AssetType"
      },
      "Body_upload_asset_v1_assets_post": {
        "properties": {
          "asset_type": {
            "$ref": "#/components/schemas/AssetType"
          },
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "asset_type",
          "file"
        ],
        "title": "Body_upload_asset_v1_assets_post"
      },
      "ContentRequest": {
        "properties": {
          "topic": {
            "type": "string",
            "maxLength": 500,
            "minLength": 1,
            "title": "Topic"
          },
          "style": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Style",
            "default": "financial-news"
          },
          "duration_seconds": {
            "type": "integer",
            "maximum": 3600.0,
            "minimum": 1.0,
            "title": "Duration Seconds",
            "default": 35
          },
          "voice_gender": {
            "type": "string",
            "enum": [
              "female",
              "male"
            ],
            "title": "Voice Gender",
            "default": "female"
          },
          "voice_age": {
            "type": "string",
            "enum": [
              "child",
              "teenager",
              "young adult",
              "middle-aged",
              "elderly"
            ],
            "title": "Voice Age",
            "default": "young adult"
          },
          "voice_pitch": {
            "type": "string",
            "enum": [
              "very low pitch",
              "low pitch",
              "moderate pitch",
              "high pitch",
              "very high pitch"
            ],
            "title": "Voice Pitch",
            "default": "moderate pitch"
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/ResearchPlatform"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Platforms"
          },
          "source_url": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2083,
                "minLength": 1,
                "format": "uri"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Url"
          },
          "voice_reference_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Reference Asset Id"
          },
          "voice_reference_transcript": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Voice Reference Transcript"
          },
          "voice_clone_authorized": {
            "type": "boolean",
            "title": "Voice Clone Authorized",
            "default": false
          },
          "visual_asset_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Visual Asset Id"
          }
        },
        "type": "object",
        "required": [
          "topic"
        ],
        "title": "ContentRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JobApproval": {
        "properties": {
          "publish": {
            "type": "boolean",
            "title": "Publish",
            "default": true
          },
          "platforms": {
            "items": {
              "$ref": "#/components/schemas/ResearchPlatform"
            },
            "type": "array",
            "maxItems": 6,
            "title": "Platforms",
            "description": "Plataformas destino. Si se deja vacio se usan las del trabajo original."
          },
          "note": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ],
            "title": "Note",
            "description": "Motivo de la decision"
          }
        },
        "type": "object",
        "title": "JobApproval",
        "description": "Decision humana sobre un video ya renderizado.\n\n``publish`` permite aprobar sin publicar (por ejemplo para revisarlo en\notros canales antes). Si no se indica, se publica."
      },
      "JobCompletion": {
        "properties": {
          "output": {
            "additionalProperties": true,
            "type": "object",
            "title": "Output"
          }
        },
        "type": "object",
        "required": [
          "output"
        ],
        "title": "JobCompletion"
      },
      "JobCreate": {
        "properties": {
          "worker": {
            "$ref": "#/components/schemas/WorkerType"
          },
          "request": {
            "$ref": "#/components/schemas/ContentRequest"
          }
        },
        "type": "object",
        "required": [
          "worker",
          "request"
        ],
        "title": "JobCreate"
      },
      "JobFailure": {
        "properties": {
          "error": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
