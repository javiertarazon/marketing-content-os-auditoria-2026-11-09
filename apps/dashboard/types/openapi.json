    "/v1/jobs/{job_id}/approve": {
      "post": {
        "summary": "Approve Job",
        "description": "Aprueba un video renderizado y, salvo que se indique lo contrario, lo publica.\n\nEs idempotente: volver a aprobar un trabajo ya aprobado reintenta la\npublicacion, que es la forma de recuperarla si el scheduler estaba caido.",
        "operationId": "approve_job_v1_jobs__job_id__approve_post",
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
