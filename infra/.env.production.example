# Do not expose API, PostgreSQL, or Redis directly to the internet.
# Put the API behind an HTTPS reverse proxy and configure CORS to its origin.
#
# Este archivo es la fuente de las variables que el compose de infra
# interpola (services.*.environment). El servicio `api` y el `publisher`
# leen ademas el `.env` de la raiz del repositorio (env_file: ../.env).
DOMAIN=content.example.com
API_BASE_URL=https://content.example.com
POSTGRES_USER=content
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=content
WORKER_API_TOKEN=replace-with-a-different-long-random-token
DATABASE_URL=postgresql://content:replace-with-a-long-random-password@postgres:5432/content
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://content.example.com
NEXT_PUBLIC_API_BASE_URL=https://content.example.com

# Mixpost Lite (scheduler). APP_KEY es una clave base64 de 32 bytes.
MIXPOST_URL=https://content.example.com/mixpost
MIXPOST_DOMAIN=content.example.com
MIXPOST_APP_KEY=base64:REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
MIXPOST_DB_NAME=mixpost
MIXPOST_DB_USER=mixpost
MIXPOST_DB_PASSWORD=replace-with-a-long-random-password
MIXPOST_DB_ROOT_PASSWORD=replace-with-a-different-long-random-password

# Open-Dispatch (MIT): scheduler de publicacion para TikTok, Instagram y
# YouTube. El mismo token debe estar en el .env de la raiz (lo leen el
# publisher y el contenedor de Open-Dispatch).
OPEN_DISPATCH_BASE_URL=https://content.example.com
OPEN_DISPATCH_API_TOKEN=replace-with-a-long-random-token
PUBLISHER_BACKEND=open_dispatch
NEXT_PUBLIC_OPEN_DISPATCH_URL=https://content.example.com
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
IG_USER_ID=
IG_TOKEN=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
